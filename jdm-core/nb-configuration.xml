<?xml version="1.0" encoding="UTF-8"?>
<project-shared-configuration>
    <!--
        This file contains additional configuration written by modules in the NetBeans IDE.
        The configuration is intended to be shared among all the users of project and
        therefore it is assumed to be part of version control checkout.
        Without this configuration present, some functionality in the IDE may be limited or fail altogether.
    -->
    <properties xmlns="http://www.netbeans.org/ns/maven-properties-data/1">
        <!--
            Pin this Maven project to JDK 25 in all NetBeans versions (25, 30, etc.).
            The value must match the display name of a platform registered in
            Tools → Java Platforms. Standard NetBeans naming is "JDK_25".
            If your NB 30 platform registration used a different name, update this value.
        -->
        <netbeans.hint.jdkPlatform>JDK_25</netbeans.hint.jdkPlatform>
    </properties>
    <actions>
        <!--
            Custom run action that injects required JVM flags into exec:exec.
            NetBeans' default run action sets -Dexec.vmArgs= (empty string),
            which makes it impossible to add JVM args from the pom. Defining
            the action here gives us full control over exec.args.

            Flags explained:
              --enable-native-access=ALL-UNNAMED  suppress FlatLaF System::load warning
              --enable-preview                    required at runtime for preview-compiled classes
              -XX:+UseZGC                         minimize GC pause noise during benchmarks
        -->
        <action>
            <actionName>run</actionName>
            <packagings>
                <packaging>jar</packaging>
            </packagings>
            <goals>
                <goal>process-classes</goal>
                <goal>org.codehaus.mojo:exec-maven-plugin:3.2.0:exec</goal>
            </goals>
            <properties>
                <exec.executable>${java.home}/bin/java</exec.executable>
                <exec.args>--enable-native-access=ALL-UNNAMED --enable-preview -XX:+UseZGC -classpath %classpath jdiskmark.App</exec.args>
            </properties>
        </action>
    </actions>
</project-shared-configuration>
