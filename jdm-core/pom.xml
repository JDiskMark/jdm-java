<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>jdiskmark</groupId>
        <artifactId>jdm-java</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jdm-core</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>7.4.4.Final</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>7.4.4.Final</version>
        </dependency>
        <!-- hibernate-agroal is intentionally excluded: it requires java.security.jgss
             (Kerberos/GSSAPI) which jpackage strips from the bundled JRE on macOS,
             causing NoClassDefFoundError: org/ietf/jgss/GSSException at startup.
             Hibernate's built-in pool (hibernate.connection.pool_size) is used instead. -->

        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derby</artifactId>
            <version>10.17.1.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derbytools</artifactId>
            <version>10.17.1.0</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-csv</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.2.0</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.7.1</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-intellij-themes</artifactId>
            <version>3.7.1</version>
        </dependency>
        <dependency>
            <groupId>com.miglayout</groupId>
            <artifactId>miglayout-swing</artifactId>
            <version>11.3</version>
        </dependency>
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>1.5.6</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.5</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Default resources directory -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- Dump resolved dependency versions to a text file so the Ant
                 target can extract them into build.properties automatically.
                 Runs in initialize (before process-resources). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>list-deps</id>
                        <phase>initialize</phase>
                        <goals><goal>list</goal></goals>
                        <configuration>
                            <outputFile>${project.build.directory}/dep-list.txt</outputFile>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>jdiskmark.App</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Merge duplicate META-INF/LICENSE* and NOTICE* files across
                                     dependencies instead of silently picking one and warning. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Exclude module-info.class from all JARs: it is
                                             meaningless in a fat JAR and triggers the
                                             "Shading will break its strong encapsulation"
                                             warning for every modular dependency. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- ManifestResourceTransformer builds the output
                                             manifest from scratch; individual MANIFEST.MF
                                             files from dependencies are not needed. -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <!-- Generate build.properties directly into target/classes/META-INF/
                             so App.class.getResourceAsStream("/META-INF/build.properties")
                             works for both IDE (class files) and the shaded JAR.
                             Runs during process-resources so it is available at compile time
                             and gets bundled by the shade plugin at package time. -->
                        <id>generate-build-properties</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.outputDirectory}/META-INF"/>
                                <tstamp>
                                    <format property="builtat"
                                            pattern="MM/dd/yyyy hh:mm aa"
                                            timezone="America/Los_Angeles"/>
                                    <!-- Build metadata segment for local display.version: MMdd.HHmm -->
                                    <format property="local.build.meta"
                                            pattern="MMdd.HHmm"
                                            timezone="America/Los_Angeles"/>
                                </tstamp>
                                <exec executable="whoami" outputproperty="whoami"
                                      failonerror="false"/>
                                <exec executable="git" outputproperty="git.commit.hash"
                                      failonerror="false" failifexecutionfails="false">
                                    <arg value="rev-parse"/>
                                    <arg value="--short"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <exec executable="git" outputproperty="git.branch.raw"
                                      failonerror="false" failifexecutionfails="false">
                                    <arg value="rev-parse"/>
                                    <arg value="--abbrev-ref"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <exec executable="git" outputproperty="git.status.out"
                                      failonerror="false" failifexecutionfails="false">
                                    <arg value="status"/>
                                    <arg value="--porcelain"/>
                                </exec>
                                <condition property="git.dirty.flag" value="true" else="false">
                                    <not><equals arg1="${git.status.out}" arg2=""/></not>
                                </condition>
                                <!-- ============================================================
                                     LOCAL PRE-RELEASE LABEL
                                     Computed when display.version / install.version are NOT
                                     already set externally (CI passes -Ddisplay.version=...).
                                     Produces:  install = 0.9.0-a.d
                                               display = 0.9.0-a.d+MMdd.HHmm
                                     On release/* and main: no prerelease label.
                                     ============================================================ -->

                                <!-- Strip -SNAPSHOT to get the numeric base (e.g. 0.9.0) -->
                                <loadresource property="local.base.version">
                                    <string value="${project.version}"/>
                                    <filterchain>
                                        <tokenfilter>
                                            <replaceregex pattern="-SNAPSHOT$" replace=""/>
                                        </tokenfilter>
                                    </filterchain>
                                </loadresource>

                                <!-- Sanitize the full branch name:
                                     hyphens/underscores become dots; slashes kept for leaf
                                     extraction; non-[a-zA-Z0-9./] stripped; consecutive dots
                                     collapsed; leading/trailing dots trimmed. -->
                                <loadresource property="git.branch.san">
                                    <string value="${git.branch.raw}"/>
                                    <filterchain>
                                        <tokenfilter>
                                            <replaceregex pattern="[-_]"             replace="." flags="g"/>
                                            <replaceregex pattern="[^a-zA-Z0-9./]"   replace=""  flags="g"/>
                                            <replaceregex pattern="\.{2,}"           replace="." flags="g"/>
                                            <replaceregex pattern="^[.]+"            replace=""/>
                                            <replaceregex pattern="[.]+$"            replace=""/>
                                        </tokenfilter>
                                    </filterchain>
                                </loadresource>

                                <!-- Extract the leaf (part after the last /).
                                     Strip any non-[a-zA-Z0-9.] chars left, then
                                     lowercase A-Z, truncate to 16 chars. -->
                                <loadresource property="git.branch.leaf.raw">
                                    <string value="${git.branch.san}"/>
                                    <filterchain>
                                        <tokenfilter>
                                            <replaceregex pattern="^.*/"                replace=""/>
                                            <replaceregex pattern="[^a-zA-Z0-9.]+"     replace=""  flags="g"/>
                                            <replaceregex pattern="^(.{1,16}).*$"       replace="\1"/>
                                            <replaceregex pattern="[.]+$"               replace=""/>
                                        </tokenfilter>
                                    </filterchain>
                                </loadresource>
                                <!-- Lowercase the leaf via A-Z → a-z character substitution chains.
                                     Ant has no single lowercase op; we map each uppercase letter. -->
                                <loadresource property="git.branch.leaf">
                                    <string value="${git.branch.leaf.raw}"/>
                                    <filterchain>
                                        <tokenfilter>
                                            <replaceregex pattern="A" replace="a" flags="g"/>
                                            <replaceregex pattern="B" replace="b" flags="g"/>
                                            <replaceregex pattern="C" replace="c" flags="g"/>
                                            <replaceregex pattern="D" replace="d" flags="g"/>
                                            <replaceregex pattern="E" replace="e" flags="g"/>
                                            <replaceregex pattern="F" replace="f" flags="g"/>
                                            <replaceregex pattern="G" replace="g" flags="g"/>
                                            <replaceregex pattern="H" replace="h" flags="g"/>
                                            <replaceregex pattern="I" replace="i" flags="g"/>
                                            <replaceregex pattern="J" replace="j" flags="g"/>
                                            <replaceregex pattern="K" replace="k" flags="g"/>
                                            <replaceregex pattern="L" replace="l" flags="g"/>
                                            <replaceregex pattern="M" replace="m" flags="g"/>
                                            <replaceregex pattern="N" replace="n" flags="g"/>
                                            <replaceregex pattern="O" replace="o" flags="g"/>
                                            <replaceregex pattern="P" replace="p" flags="g"/>
                                            <replaceregex pattern="Q" replace="q" flags="g"/>
                                            <replaceregex pattern="R" replace="r" flags="g"/>
                                            <replaceregex pattern="S" replace="s" flags="g"/>
                                            <replaceregex pattern="T" replace="t" flags="g"/>
                                            <replaceregex pattern="U" replace="u" flags="g"/>
                                            <replaceregex pattern="V" replace="v" flags="g"/>
                                            <replaceregex pattern="W" replace="w" flags="g"/>
                                            <replaceregex pattern="X" replace="x" flags="g"/>
                                            <replaceregex pattern="Y" replace="y" flags="g"/>
                                            <replaceregex pattern="Z" replace="z" flags="g"/>
                                        </tokenfilter>
                                    </filterchain>
                                </loadresource>

                                <!-- Mark release and main branches — they get no prerelease label.
                                     Case-insensitive match via (?i) prefix. -->
                                <condition property="local.is.release">
                                    <or>
                                        <matches pattern="(?i)^main$"        string="${git.branch.san}"/>
                                        <matches pattern="(?i)^release$"     string="${git.branch.san}"/>
                                        <matches pattern="(?i)^release/"     string="${git.branch.san}"/>
                                    </or>
                                </condition>

                                <!-- Mark unknown/empty branch: git unavailable (property unset
                                     or empty), or detached HEAD (git returns literal "HEAD").
                                     Must be first so subsequent slug routing is skipped. -->
                                <condition property="local.slug" value="local">
                                    <or>
                                        <not><isset property="git.branch.raw"/></not>
                                        <equals arg1="${git.branch.raw}" arg2=""/>
                                        <equals arg1="${git.branch.raw}" arg2="HEAD"/>
                                    </or>
                                </condition>

                                <!-- Slug routing — first match wins (Ant properties are write-once).
                                     Case-insensitive matching via (?i); slug values are always lowercase. -->
                                <condition property="local.slug" value="d">
                                    <matches pattern="(?i)^dev$" string="${git.branch.san}"/>
                                </condition>
                                <condition property="local.slug" value="d.${git.branch.leaf}">
                                    <matches pattern="(?i)^dev/" string="${git.branch.san}"/>
                                </condition>
                                <condition property="local.slug" value="f.${git.branch.leaf}">
                                    <or>
                                        <matches pattern="(?i)^feature/" string="${git.branch.san}"/>
                                        <matches pattern="(?i)^feat/"    string="${git.branch.san}"/>
                                    </or>
                                </condition>
                                <condition property="local.slug" value="b.${git.branch.leaf}">
                                    <or>
                                        <matches pattern="(?i)^bug/"    string="${git.branch.san}"/>
                                        <matches pattern="(?i)^bugfix/" string="${git.branch.san}"/>
                                    </or>
                                </condition>
                                <!-- Final fallback: use the leaf (any other branch shape) -->
                                <condition property="local.slug" value="${git.branch.leaf}">
                                    <not><isset property="local.slug"/></not>
                                </condition>

                                <!-- Assemble local version strings.
                                     Priority order (Ant write-once means first setter wins):
                                     1. Release/main   — project.version unchanged (keeps -SNAPSHOT
                                        if that is what is set; avoids .jdm/0.9.0/ collision).
                                     2. Non-SNAPSHOT   — -Drevision carried a real label already;
                                        pass through to avoid double-labelling (0.9.0-ci.d.47-a.d).
                                     3. SNAPSHOT + dev — generate the a.SLUG[+meta] label. -->
                                <condition property="local.version.is.snapshot">
                                    <matches pattern=".*-SNAPSHOT$" string="${project.version}"/>
                                </condition>

                                <condition property="local.display.version" value="${project.version}">
                                    <isset property="local.is.release"/>
                                </condition>
                                <condition property="local.install.version" value="${project.version}">
                                    <isset property="local.is.release"/>
                                </condition>

                                <!-- Non-SNAPSHOT, non-release: -Drevision already set a real label. -->
                                <condition property="local.display.version" value="${project.version}">
                                    <not><isset property="local.version.is.snapshot"/></not>
                                </condition>
                                <condition property="local.install.version" value="${project.version}">
                                    <not><isset property="local.version.is.snapshot"/></not>
                                </condition>

                                <!-- SNAPSHOT on a non-release branch: generate the a.SLUG label. -->
                                <condition property="local.display.version"
                                           value="${local.base.version}-a.${local.slug}+${local.build.meta}">
                                    <not><isset property="local.display.version"/></not>
                                </condition>
                                <condition property="local.install.version"
                                           value="${local.base.version}-a.${local.slug}">
                                    <not><isset property="local.install.version"/></not>
                                </condition>

                                <!-- Effective versions: CI override wins; local label is the fallback. -->
                                <condition property="eff.display.version"
                                           value="${display.version}" else="${local.display.version}">
                                    <isset property="display.version"/>
                                </condition>
                                <!-- install.version: same, but no +MMdd.HHmm build-metadata suffix. -->
                                <condition property="eff.install.version"
                                           value="${install.version}" else="${local.install.version}">
                                    <isset property="install.version"/>
                                </condition>
                                <!-- Extract library versions from the dependency
                                     list generated by maven-dependency-plugin:list.
                                     Format: groupId:artifactId:jar:VERSION:scope -->
                                <loadfile property="lib.flatlaf.ver" srcFile="${project.build.directory}/dep-list.txt" failonerror="false">
                                    <filterchain>
                                        <linecontains><contains value="com.formdev:flatlaf:jar:"/></linecontains>
                                        <tokenfilter><replaceregex pattern=".*:jar:([^:]+):.*" replace="\1"/></tokenfilter>
                                        <striplinebreaks/>
                                    </filterchain>
                                </loadfile>
                                <loadfile property="lib.jfreechart.ver" srcFile="${project.build.directory}/dep-list.txt" failonerror="false">
                                    <filterchain>
                                        <linecontains><contains value="org.jfree:jfreechart:jar:"/></linecontains>
                                        <tokenfilter><replaceregex pattern=".*:jar:([^:]+):.*" replace="\1"/></tokenfilter>
                                        <striplinebreaks/>
                                    </filterchain>
                                </loadfile>
                                <loadfile property="lib.hibernate.ver" srcFile="${project.build.directory}/dep-list.txt" failonerror="false">
                                    <filterchain>
                                        <linecontains><contains value="org.hibernate.orm:hibernate-core:jar:"/></linecontains>
                                        <tokenfilter><replaceregex pattern=".*:jar:([^:]+):.*" replace="\1"/></tokenfilter>
                                        <striplinebreaks/>
                                    </filterchain>
                                </loadfile>
                                <loadfile property="lib.derby.ver" srcFile="${project.build.directory}/dep-list.txt" failonerror="false">
                                    <filterchain>
                                        <linecontains><contains value="org.apache.derby:derby:jar:"/></linecontains>
                                        <tokenfilter><replaceregex pattern=".*:jar:([^:]+):.*" replace="\1"/></tokenfilter>
                                        <striplinebreaks/>
                                    </filterchain>
                                </loadfile>
                                <loadfile property="lib.picocli.ver" srcFile="${project.build.directory}/dep-list.txt" failonerror="false">
                                    <filterchain>
                                        <linecontains><contains value="info.picocli:picocli:jar:"/></linecontains>
                                        <tokenfilter><replaceregex pattern=".*:jar:([^:]+):.*" replace="\1"/></tokenfilter>
                                        <striplinebreaks/>
                                    </filterchain>
                                </loadfile>
                                <propertyfile
                                    file="${project.build.outputDirectory}/META-INF/build.properties"
                                    comment="This file is automatically generated - DO NOT EDIT">
                                    <entry key="buildtime"       value="${builtat}"/>
                                    <entry key="builder"         value="${whoami}"/>
                                    <entry key="version"         value="${project.version}"/>
                                    <entry key="display.version" value="${eff.display.version}"/>
                                    <entry key="install.version" value="${eff.install.version}"/>
                                    <entry key="git.commit"      value="${git.commit.hash}"/>
                                    <entry key="git.dirty"       value="${git.dirty.flag}"/>
                                    <entry key="jdk.version"     value="${java.runtime.version}"/>
                                    <entry key="maven.version"   value="${maven.version}"/>
                                    <entry key="os.name"         value="${os.name}"/>
                                    <entry key="os.version"      value="${os.version}"/>
                                    <entry key="os.arch"         value="${os.arch}"/>
                                    <entry key="lib.flatlaf"     value="${lib.flatlaf.ver}"/>
                                    <entry key="lib.jfreechart"  value="${lib.jfreechart.ver}"/>
                                    <entry key="lib.hibernate"   value="${lib.hibernate.ver}"/>
                                    <entry key="lib.derby"       value="${lib.derby.ver}"/>
                                    <entry key="lib.picocli"     value="${lib.picocli.ver}"/>
                                    <entry key="lib.smartctl"    value="${smartctl.version}"/>
                                </propertyfile>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-windows-runtime-assets</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Copy Windows runtime assets into target/ so jpackage
                                     bundles them into the MSI app/ directory.
                                     UtilOs.java falls back to "./app/<file>" when the
                                     script is not found next to the CWD. -->
                                <copy file="${project.basedir}/capacity.ps1"
                                      todir="${project.build.directory}" overwrite="true"/>
                                <copy file="${project.basedir}/disk-model.ps1"
                                      todir="${project.build.directory}" overwrite="true"/>
                                <copy file="${project.basedir}/EmptyStandbyList.exe"
                                      todir="${project.build.directory}" overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- =========================================================
             Windows: download smartctl.exe and stage to target/.
             Activated automatically on Windows; skipped on Linux/macOS.
             download-maven-plugin caches the zip in ~/.m2 so mvn clean
             does not require a re-download.
             ========================================================= -->
        <profile>
            <id>smartctl-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>download-smartctl-windows</id>
                                <phase>generate-resources</phase>
                                <goals><goal>wget</goal></goals>
                                <configuration>
                                    <url>${smartctl.windows.url}</url>
                                    <sha256>${smartctl.windows.sha256}</sha256>
                                    <outputDirectory>${project.build.directory}/smartctl-download</outputDirectory>
                                    <outputFileName>smartctl-win.zip</outputFileName>
                                    <overwrite>false</overwrite>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-smartctl-windows</id>
                                <phase>generate-resources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/smartctl-tmp"/>
                                        <unzip src="${project.build.directory}/smartctl-download/smartctl-win.zip"
                                               dest="${project.build.directory}/smartctl-tmp"
                                               overwrite="true"/>
                                        <!-- The zip extracts to smartctl-tmp/smartctl/smartctl.exe;
                                             move the inner smartctl/ dir up to target/smartctl/. -->
                                        <move todir="${project.build.directory}/smartctl" overwrite="true">
                                            <fileset dir="${project.build.directory}/smartctl-tmp/smartctl"/>
                                        </move>
                                        <delete dir="${project.build.directory}/smartctl-tmp"/>
                                        <available file="${project.build.directory}/smartctl/smartctl.exe"
                                                   type="file"
                                                   property="smartctl.staged.ok"/>
                                        <fail message="[smartctl] staging failed: smartctl.exe not found in target/smartctl/">
                                            <condition><not><isset property="smartctl.staged.ok"/></not></condition>
                                        </fail>
                                        <echo message="[smartctl] staged OK: ${project.build.directory}/smartctl/smartctl.exe"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- =========================================================
             Linux: download smartctl and stage to target/.
             Activated automatically on Linux; skipped on Windows/macOS.
             ========================================================= -->
        <profile>
            <id>smartctl-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>download-smartctl-linux</id>
                                <phase>generate-resources</phase>
                                <goals><goal>wget</goal></goals>
                                <configuration>
                                    <url>${smartctl.linux.url}</url>
                                    <sha256>${smartctl.linux.sha256}</sha256>
                                    <outputDirectory>${project.build.directory}/smartctl-download</outputDirectory>
                                    <outputFileName>smartctl-linux.tar.gz</outputFileName>
                                    <overwrite>false</overwrite>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-smartctl-linux</id>
                                <phase>generate-resources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <!-- Extract to target/ — the tarball contains smartctl/smartctl,
                                             so this creates target/smartctl/smartctl. -->
                                        <exec executable="tar" failonerror="true">
                                            <arg value="-xzf"/>
                                            <arg value="${project.build.directory}/smartctl-download/smartctl-linux.tar.gz"/>
                                            <arg value="-C"/>
                                            <arg value="${project.build.directory}"/>
                                        </exec>
                                        <available file="${project.build.directory}/smartctl/smartctl"
                                                   type="file"
                                                   property="smartctl.staged.ok"/>
                                        <fail message="[smartctl] staging failed: smartctl not found in target/smartctl/">
                                            <condition><not><isset property="smartctl.staged.ok"/></not></condition>
                                        </fail>
                                        <chmod file="${project.build.directory}/smartctl/smartctl" perm="755"/>
                                        <echo message="[smartctl] staged OK: ${project.build.directory}/smartctl/smartctl"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- =========================================================
             macOS: download smartctl and stage to target/.
             Activated automatically on macOS; skipped on Windows/Linux.
             ========================================================= -->
        <profile>
            <id>smartctl-macos</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>download-smartctl-macos</id>
                                <phase>generate-resources</phase>
                                <goals><goal>wget</goal></goals>
                                <configuration>
                                    <url>${smartctl.macos.url}</url>
                                    <sha256>${smartctl.macos.sha256}</sha256>
                                    <outputDirectory>${project.build.directory}/smartctl-download</outputDirectory>
                                    <outputFileName>smartctl-macos.tar.gz</outputFileName>
                                    <overwrite>false</overwrite>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-smartctl-macos</id>
                                <phase>generate-resources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <!-- Extract to target/ — the tarball contains smartctl/smartctl,
                                             so this creates target/smartctl/smartctl. -->
                                        <exec executable="tar" failonerror="true">
                                            <arg value="-xzf"/>
                                            <arg value="${project.build.directory}/smartctl-download/smartctl-macos.tar.gz"/>
                                            <arg value="-C"/>
                                            <arg value="${project.build.directory}"/>
                                        </exec>
                                        <available file="${project.build.directory}/smartctl/smartctl"
                                                   type="file"
                                                   property="smartctl.staged.ok"/>
                                        <fail message="[smartctl] staging failed: smartctl not found in target/smartctl/">
                                            <condition><not><isset property="smartctl.staged.ok"/></not></condition>
                                        </fail>
                                        <chmod file="${project.build.directory}/smartctl/smartctl" perm="755"/>
                                        <echo message="[smartctl] staged OK: ${project.build.directory}/smartctl/smartctl"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
