<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>jdiskmark</groupId>
        <artifactId>jdm-dist</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>jdm-deb</artifactId>
    <packaging>pom</packaging>

    <profiles>

        <!-- =========================================================
             Linux DEB build — auto-activated on Linux only.
             On Windows/macOS this entire profile is skipped.
             ========================================================= -->
        <profile>
            <id>linux-deb</id>
            <build>
                <plugins>
                    <!-- Stage bundled smartctl binary from jdm-deps.
                         Downloads the Linux x86_64 tarball if not already
                         present. Idempotent: skipped when smartctl exists.
                         Fails the build if staging fails. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-smartctl-linux</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <property name="smartctl.stage.dir"
                                                  value="${project.basedir}/src/main/app-content"/>
                                        <property name="smartctl.bin"
                                                  value="${smartctl.stage.dir}/smartctl/smartctl"/>
                                        <condition property="smartctl.already.staged">
                                            <available file="${smartctl.bin}" type="file"/>
                                        </condition>
                                        <sequential xmlns:unless="ant:unless"
                                                    unless:set="smartctl.already.staged">
                                            <mkdir dir="${smartctl.stage.dir}"/>
                                            <get src="${smartctl.linux.url}"
                                                 dest="${project.build.directory}/smartctl-linux.tar.gz"
                                                 verbose="true"
                                                 retries="3"/>
                                            <checksum file="${project.build.directory}/smartctl-linux.tar.gz"
                                                      algorithm="SHA-256"
                                                      property="smartctl.checksum"/>
                                            <condition property="smartctl.checksum.ok">
                                                <equals arg1="${smartctl.checksum}"
                                                        arg2="${smartctl.linux.sha256}"
                                                        casesensitive="false"/>
                                            </condition>
                                            <fail message="[smartctl] Checksum mismatch! Expected ${smartctl.linux.sha256} got ${smartctl.checksum}">
                                                <condition><not><isset property="smartctl.checksum.ok"/></not></condition>
                                            </fail>
                                            <exec executable="tar" failonerror="true">
                                                <arg value="-xzf"/>
                                                <arg value="${project.build.directory}/smartctl-linux.tar.gz"/>
                                                <arg value="-C"/>
                                                <arg value="${smartctl.stage.dir}"/>
                                            </exec>
                                        </sequential>
                                        <available file="${smartctl.bin}"
                                                   type="file"
                                                   property="smartctl.staged.ok"/>
                                        <fail message="[smartctl] staging failed: expected ${smartctl.bin}">
                                            <condition><not><isset property="smartctl.staged.ok"/></not></condition>
                                        </fail>
                                        <echo message="[smartctl] staged OK: ${smartctl.bin}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>build-deb</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>deb</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}</argument>
                                        <argument>--name</argument><argument>${pkg.name}</argument>
                                        <!-- DEB supports the full semantic version -->
                                        <argument>--app-version</argument><argument>${project.version}</argument>
                                        <argument>--vendor</argument><argument>${app.name} Developers</argument>
                                        <argument>--description</argument><argument>Java disk benchmark utility for read/write performance testing</argument>
                                        <argument>--input</argument><argument>${project.basedir}/../../jdm-core/target</argument>
                                        <argument>--main-jar</argument><argument>jdm-core-${project.version}.jar</argument>
                                        <argument>--main-class</argument><argument>jdiskmark.App</argument>
                                        <argument>--java-options</argument><argument>${jvm.run.options}</argument>
                                        <argument>--linux-shortcut</argument>
                                        <argument>--linux-menu-group</argument><argument>Utility</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/../../jdm-core/src/main/resources/icons/${app.icon.linux}</argument>
                                        <argument>--resource-dir</argument><argument>${project.basedir}/src/main/jpackage-resources</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                            <!-- Inject fields that jpackage does not generate into the desktop
                                 entry inside the DEB: Name=JDiskMark (display name),
                                 StartupWMClass (for GNOME taskbar icon matching),
                                 GenericName, and Keywords.
                                 The file is patched in-place; no renaming is done so that
                                 xdg-desktop-menu's vendor-prefix requirement is satisfied. -->
                            <execution>
                                <id>patch-deb-desktop</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument><![CDATA[
set -e
mapfile -t DEBS < <(find "${project.build.directory}" -maxdepth 1 -type f -name "*.deb" | sort)
if [ "${#DEBS[@]}" -ne 1 ]; then
    echo "[patch] Expected exactly one .deb in ${project.build.directory}, found ${#DEBS[@]}" >&2
    printf '  %s\n' "${DEBS[@]}" >&2
    exit 1
fi
DEB="${DEBS[0]}"
WORK="${project.build.directory}/deb-repack"
echo "[patch] Patching desktop entry in $DEB"
rm -rf "$WORK" && mkdir -p "$WORK/pkg"
dpkg-deb -R "$DEB" "$WORK/pkg"
DESKTOP=$(find "$WORK/pkg/opt" -name "*.desktop" | grep -v runtime | head -1)
if [ -n "$DESKTOP" ]; then
    sed -i 's|^Name=jdiskmark$|Name=JDiskMark|' "$DESKTOP"
    sed -i 's|^Categories=\(.*\)|GenericName=Disk Benchmark\nCategories=\1\nKeywords=disk;benchmark;performance;storage;speed;\nStartupWMClass=jdiskmark-App|' "$DESKTOP"
    echo "[patch] Result ($(basename $DESKTOP)):"
    cat "$DESKTOP"
fi

# Inject bundled smartctl runtime (staged by stage-smartctl-linux Ant task).
# --app-content is not reliable for the DEB format so we inject here instead.
APP_CONTENT="${project.basedir}/src/main/app-content"
if [ -d "$APP_CONTENT/smartctl" ]; then
    cp -r "$APP_CONTENT/smartctl" "$WORK/pkg/opt/jdiskmark/smartctl"
    chmod 755 "$WORK/pkg/opt/jdiskmark/smartctl/smartctl"
    echo "[patch] Injected smartctl: $($WORK/pkg/opt/jdiskmark/smartctl/smartctl --version 2>&1 | head -1)"
else
    echo "[patch] WARNING: app-content/smartctl not found — skipping (slim build or local dev)"
fi

# Copy the polkit policy file so postinst can install it from the package root.
POLICY="${project.basedir}/src/main/jpackage-resources/net.jdiskmark.smartctl.policy"
if [ -f "$POLICY" ]; then
    cp "$POLICY" "$WORK/pkg/opt/jdiskmark/net.jdiskmark.smartctl.policy"
    chmod 644 "$WORK/pkg/opt/jdiskmark/net.jdiskmark.smartctl.policy"
    echo "[patch] Included polkit policy file"
fi

# Create a /usr/bin symlink so `jdiskmark` is on PATH.
# Including it in the package contents makes it a dpkg-tracked file —
# dpkg removes it automatically on uninstall, no prerm needed.
mkdir -p "$WORK/pkg/usr/bin"
ln -sf /opt/jdiskmark/bin/jdiskmark "$WORK/pkg/usr/bin/jdiskmark"
echo "[patch] Created /usr/bin/jdiskmark symlink"

# Make xdg-desktop-menu failure non-fatal in postinst.
# jpackage's generated postinst uses set -e, so xdg-desktop-menu failing
# on headless systems (no display server) aborts the entire script.
# Wrap the xdg-desktop-menu call with set +e/set -e so it can't kill the hook.
POSTINST="$WORK/pkg/DEBIAN/postinst"
if [ -f "$POSTINST" ] && grep -qE '^[[:space:]]*xdg-desktop-menu' "$POSTINST"; then
    sed -i -E 's|^([[:space:]]*)xdg-desktop-menu(.*)$|\1set +e; xdg-desktop-menu\2; set -e|' "$POSTINST"
    echo "[patch] Made xdg-desktop-menu non-fatal in postinst"
fi

dpkg-deb -b "$WORK/pkg" "$DEB"
echo "[patch] Done."
                                        ]]></argument>
                                    </arguments>
                                </configuration>
                            </execution>

                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>
</project>
