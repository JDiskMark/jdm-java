<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>jdiskmark</groupId>
        <artifactId>jdm-dist</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>jdm-pkg</artifactId>
    <packaging>pom</packaging>

    <profiles>
        <profile>
            <id>macos-pkg</id>
            <build>
                <plugins>
                    <!-- Stage bundled smartctl binary from jdm-deps.
                         Downloads the macOS ARM64 tarball if not already
                         present. Idempotent: skipped when smartctl exists.
                         Verifies SHA-256 checksum. Fails the build if
                         staging fails. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-smartctl-macos</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <property name="smartctl.stage.dir"
                                                  value="${project.basedir}/app-content"/>
                                        <property name="smartctl.bin"
                                                  value="${smartctl.stage.dir}/smartctl/smartctl"/>
                                        <condition property="smartctl.already.staged">
                                            <available file="${smartctl.bin}" type="file"/>
                                        </condition>
                                        <sequential xmlns:unless="ant:unless"
                                                    unless:set="smartctl.already.staged">
                                            <mkdir dir="${smartctl.stage.dir}"/>
                                            <get src="${smartctl.macos.url}"
                                                 dest="${project.build.directory}/smartctl-macos.tar.gz"
                                                 verbose="true"
                                                 retries="3"/>
                                            <checksum file="${project.build.directory}/smartctl-macos.tar.gz"
                                                      algorithm="SHA-256"
                                                      property="smartctl.checksum"/>
                                            <condition property="smartctl.checksum.ok">
                                                <equals arg1="${smartctl.checksum}"
                                                        arg2="${smartctl.macos.sha256}"
                                                        casesensitive="false"/>
                                            </condition>
                                            <fail message="[smartctl] Checksum mismatch! Expected ${smartctl.macos.sha256} got ${smartctl.checksum}">
                                                <condition><not><isset property="smartctl.checksum.ok"/></not></condition>
                                            </fail>
                                            <exec executable="tar" failonerror="true">
                                                <arg value="-xzf"/>
                                                <arg value="${project.build.directory}/smartctl-macos.tar.gz"/>
                                                <arg value="-C"/>
                                                <arg value="${smartctl.stage.dir}"/>
                                            </exec>
                                        </sequential>
                                        <available file="${smartctl.bin}"
                                                   type="file"
                                                   property="smartctl.staged.ok"/>
                                        <fail message="[smartctl] staging failed: expected ${smartctl.bin}">
                                            <condition><not><isset property="smartctl.staged.ok"/></not></condition>
                                        </fail>
                                        <echo message="[smartctl] staged OK: ${smartctl.bin}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>package-macos</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.basedir}/package-pkg.sh</executable>
                                    <arguments>
                                        <argument>${project.version}</argument>
                                        <argument>${app.name}</argument>
                                        <argument>${pkg.name}</argument>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${project.basedir}/../../jdm-core/target</argument>
                                        <argument>${signing.identity}</argument>
                                        <argument>${mac.installer.signing.identity}</argument>
                                        <argument>${apple.id}</argument>
                                        <argument>${apple.password}</argument>
                                        <argument>${apple.team.id}</argument>
                                        <argument>${mac.package.identifier}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <properties>
        <mac.package.identifier>net.jdiskmark.JDiskMark</mac.package.identifier>
        <!-- Defaults to empty if not provided via CLI or profiles -->
        <signing.identity></signing.identity>
        <mac.installer.signing.identity></mac.installer.signing.identity>
        <apple.id></apple.id>
        <apple.password></apple.password>
        <apple.team.id></apple.team.id>
    </properties>
</project>
