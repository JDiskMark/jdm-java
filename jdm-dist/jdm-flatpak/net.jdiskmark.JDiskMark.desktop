[Desktop Entry]
Type=Application
Name=JDiskMark
GenericName=Disk Benchmark
Comment=Measure the read and write performance of your storage devices
Exec=jdiskmark
Icon=net.jdiskmark.JDiskMark
Terminal=false
Categories=Utility;System;
Keywords=disk;benchmark;performance;storage;speed;
# JDiskMark is a Java Swing app — it runs through XWayland on Wayland
# compositors. The Flatpak sandbox does NOT rewrite WM_CLASS for X11/XWayland
# apps, so the compositor sees the value jpackage sets: jdiskmark-App.
# (The Flatpak app-id net.jdiskmark.JDiskMark is only used for native Wayland.)
StartupWMClass=jdiskmark-App
