[Desktop Entry]
Type=Application
Name=JDiskMark
GenericName=Disk Benchmark
Comment=Measure the read and write performance of your storage devices
Exec=jdiskmark
Icon=net.jdiskmark.JDiskMark
Terminal=false
Categories=Utility;System;
Keywords=disk;benchmark;performance;storage;speed;
# Flatpak apps are presented to the compositor with WM_CLASS set to the
# Flatpak app ID. This entry tells GNOME/KDE which desktop file matches
# the running window so the taskbar shows the correct icon.
StartupWMClass=net.jdiskmark.JDiskMark
